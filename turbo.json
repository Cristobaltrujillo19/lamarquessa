{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      // Turborepo solo pasa a la tarea las variables declaradas aquí. Las
      // NEXT_PUBLIC_*/PUBLIC_* se infieren por framework, pero los secretos
      // del panel hay que nombrarlos o no llegan al build.
      "env": [
        "ADMIN_API_SECRET",
        "PANEL_PASSWORD",
        "CONVEX_DEPLOY_KEY",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_GTM_ID",
        "NEXT_PUBLIC_GA4_ID"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {}
  }
}
