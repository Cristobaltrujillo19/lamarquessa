---
import IconoConcha from './IconoConcha.astro';
import IconoVelero from './IconoVelero.astro';
import IconoHibisco from './IconoHibisco.astro';

const elementos = [
  { Icono: IconoConcha, titulo: 'La concha', texto: 'En honor a nuestra primera pieza.' },
  { Icono: IconoVelero, titulo: 'El velero', texto: 'Por el sueño de recorrer el mundo navegando.' },
  { Icono: IconoHibisco, titulo: 'El hibisco', texto: 'La clara representación del Caribe en una flor.' },
];
---

<section class="seccion elementos">
  <div class="contenedor">
    <header class="encabezado reveal">
      <p class="kicker">Elementos</p>
      <h2 class="titulo-seccion">Nuestros <span class="script">símbolos</span></h2>
    </header>

    <div class="grilla">
      {
        elementos.map(({ Icono, titulo, texto }) => (
          <div class="elemento reveal">
            <Icono tamano={84} class="icono" />
            <h3>{titulo}</h3>
            <p>{texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .elementos {
    background: var(--crema);
  }

  .encabezado {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .grilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(32px, 5vw, 56px);
  }

  .elemento {
    text-align: center;
  }

  .icono {
    color: var(--cobre);
    margin: 0 auto 18px;
  }

  h3 {
    font-size: 27px;
    color: var(--cacao);
  }

  p {
    margin-top: 8px;
    color: var(--cacao-suave);
    max-width: 28ch;
    margin-inline: auto;
  }
</style>
