---
import IconoConcha from './IconoConcha.astro';
import { enlaceTienda, INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../lib/site';
---

<section class="cierre">
  <div class="contenedor centro reveal">
    <IconoConcha tamano={64} class="concha" />
    <h2 class="frase">Del amor, del mar<br />y del amor al mar.</h2>
    <p class="sub">Sé de las primeras en llevar el tuyo.</p>
    <div class="acciones">
      <a class="boton boton-primario" href={enlaceTienda()}>
        Ir a la tienda
      </a>
      <a class="boton boton-fantasma" href={INSTAGRAM_URL} target="_blank" rel="noopener">
        Síguenos {INSTAGRAM_HANDLE}
      </a>
    </div>
  </div>
</section>

<style>
  .cierre {
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, color-mix(in srgb, var(--cielo) 35%, transparent), transparent 70%),
      var(--arena-clara);
    padding-block: clamp(80px, 13vw, 140px);
    text-align: center;
  }

  .centro {
    max-width: 680px;
  }

  .concha {
    color: var(--cobre);
    margin: 0 auto 24px;
  }

  .frase {
    font-size: clamp(32px, 6vw, 60px);
    color: var(--cacao);
    line-height: 1.12;
  }

  .sub {
    margin-top: 18px;
    font-family: var(--fuente-cita);
    font-style: italic;
    font-size: clamp(18px, 2.4vw, 22px);
    color: var(--cobre-hondo);
  }

  .acciones {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }
</style>
