---
import LogoMarca from './LogoMarca.astro';
import { enlaceTienda } from '../lib/site';

// URL de la tienda (fase 2). En local: PUBLIC_SHOP_URL=http://localhost:3000
const tiendaUrl = import.meta.env.PUBLIC_SHOP_URL ?? null;
---

<header class="cab solido" data-cabecera>
  <div class="cab-inner contenedor">
    <button
      class="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu"
    >
      <span class="hamburguesa" aria-hidden="true"></span>
    </button>

    <nav class="cab-links" aria-label="Secciones">
      <a href="/#coleccion">Colección</a>
      <a href="/nosotros">Historia</a>
      {tiendaUrl && <a href={tiendaUrl} class="enlace-tienda">Tienda</a>}
    </nav>

    <a href="/#inicio" class="cab-logo" aria-label="La Marquessa — inicio">
      <LogoMarca variante="cobre" tamano={30} />
    </a>

    <div class="cab-acc">
      <a class="boton boton-primario cab-cta" href={enlaceTienda()}>Ir a la tienda</a>
    </div>
  </div>

  <div class="menu-movil" id="menu">
    <a href="/#coleccion">Colección</a>
    <a href="/nosotros">Historia</a>
    {tiendaUrl && <a href={tiendaUrl}>Tienda</a>}
    <a class="boton boton-primario" href={enlaceTienda()}>Ir a la tienda</a>
  </div>
</header>

<script>
  const header = document.querySelector('[data-cabecera]');
  const heroLogo = document.querySelector('[data-hero-logo]') as HTMLElement | null;
  const toggle = header?.querySelector('.menu-toggle');
  const menu = document.getElementById('menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const abierto = menu.classList.toggle('abierto');
      toggle.setAttribute('aria-expanded', String(abierto));
    });
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        menu.classList.remove('abierto');
        toggle.setAttribute('aria-expanded', 'false');
      }),
    );
  }

  // El logo central del hero se transforma en el del header al hacer scroll.
  let ticking = false;
  const actualizar = () => {
    const y = window.scrollY || 0;
    if (heroLogo) {
      const p = Math.min(y / 200, 1);
      heroLogo.style.opacity = String(1 - p);
      heroLogo.style.transform = `translateY(${(-26 * p).toFixed(1)}px) scale(${(1 - 0.3 * p).toFixed(3)})`;
      header?.classList.toggle('solido', y > 130);
    } else {
      header?.classList.add('solido');
    }
    ticking = false;
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(actualizar);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  actualizar();
</script>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 0.4s ease,
      border-color 0.4s ease;
  }

  .cab.solido {
    background: color-mix(in srgb, var(--crema) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: color-mix(in srgb, var(--cacao) 8%, transparent);
  }

  .cab-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 62px;
    padding-block: 12px;
  }

  .cab-links {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 36px);
  }

  .cab-links a {
    text-decoration: none;
    font-size: 12.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cacao);
    transition: color 0.2s ease;
  }

  .cab-links a:hover {
    color: var(--cobre);
  }

  .enlace-tienda {
    color: var(--cobre) !important;
  }

  .cab-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    text-decoration: none;
    transition: opacity 0.4s ease;
  }

  .cab.solido .cab-logo {
    opacity: 1;
  }

  .cab-acc {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cab-cta {
    font-size: 11.5px;
    padding: 0.7em 1.4em;
  }

  .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    cursor: pointer;
    place-items: center;
  }

  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--cacao);
    transition:
      transform 0.25s ease,
      top 0.25s ease,
      background 0.2s ease;
  }

  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburguesa::before {
    top: -7px;
  }
  .hamburguesa::after {
    top: 7px;
  }

  .menu-toggle[aria-expanded='true'] .hamburguesa {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .hamburguesa::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .hamburguesa::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .menu-movil {
    display: none;
    flex-direction: column;
    gap: 20px;
    padding: 22px clamp(22px, 6vw, 40px) 28px;
    background: var(--crema);
    border-top: 1px solid color-mix(in srgb, var(--cacao) 8%, transparent);
  }

  .menu-movil a {
    text-decoration: none;
    font-size: 14px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cacao);
  }

  .menu-movil.abierto {
    display: flex;
  }

  @media (max-width: 760px) {
    .cab-links {
      display: none;
    }
    .cab-acc .cab-cta {
      display: none;
    }
    .menu-toggle {
      display: inline-grid;
      position: relative;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cab,
    .cab-logo {
      transition: none;
    }
  }
</style>
