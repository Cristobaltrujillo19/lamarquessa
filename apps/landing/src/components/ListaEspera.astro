---
// Lista de espera: captura de correo para el lanzamiento.
// Sin backend aún, el envío abre WhatsApp con el correo (no se pierde el lead).
import { WAITLIST_ENDPOINT, enlaceWhatsApp, MENSAJES } from '../lib/site';
---

<section id="lista-espera" class="lista">
  <div class="contenedor centro reveal">
    <p class="kicker">Lista de espera</p>
    <h2 class="titulo-seccion">Sé la primera en <span class="script">tenerlo</span></h2>
    <p class="sub">
      Déjanos tu correo y te avisamos apenas abramos la primera colección.
      Sin spam, lo prometemos.
    </p>

    <form id="form-espera" class="form" novalidate>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="tu@correo.com"
        aria-label="Tu correo"
      />
      <button class="boton boton-primario" type="submit">Quiero entrar</button>
    </form>
    <p class="ok" id="espera-ok" hidden>¡Listo! Te avisaremos por correo. 🐚</p>
  </div>
</section>

<script define:vars={{ endpoint: WAITLIST_ENDPOINT, wa: enlaceWhatsApp(MENSAJES.reserva) }}>
  const form = document.getElementById('form-espera');
  const ok = document.getElementById('espera-ok');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('input');
    const email = String(new FormData(form).get('email') || '').trim();
    if (!email.includes('@') || !email.includes('.')) {
      input?.focus();
      return;
    }
    try {
      if (endpoint) {
        await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email }),
        });
      } else {
        window.open(wa + '%20Mi%20correo%3A%20' + encodeURIComponent(email), '_blank', 'noopener');
      }
    } catch {
      window.open(wa, '_blank', 'noopener');
    }
    form.hidden = true;
    if (ok) ok.hidden = false;
  });
</script>

<style>
  .lista {
    position: relative;
    overflow: hidden;
    background: var(--arena-clara);
    padding-block: clamp(70px, 11vw, 120px);
    text-align: center;
  }

  /* Patrón de olas del manual, muy sutil */
  .lista::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/marca/patron-cobre.png');
    background-size: 440px;
    opacity: 0.08;
    pointer-events: none;
  }

  .centro {
    position: relative;
    max-width: 600px;
  }

  .sub {
    margin: 16px auto 0;
    color: var(--cacao-suave);
    max-width: 46ch;
  }

  .form {
    margin-top: 30px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* el atributo hidden debe ganarle al display:flex */
  .form[hidden] {
    display: none;
  }

  input {
    flex: 1;
    min-width: 240px;
    max-width: 340px;
    padding: 0 18px;
    height: 50px;
    border: 1px solid color-mix(in srgb, var(--cacao) 25%, transparent);
    border-radius: var(--radio);
    background: var(--blanco);
    color: var(--cacao);
    font-family: var(--fuente-cuerpo);
    font-size: 15px;
  }

  input:focus-visible {
    outline: 2px solid var(--cobre);
    outline-offset: 2px;
    border-color: var(--cobre);
  }

  .form .boton {
    height: 50px;
  }

  .ok {
    margin-top: 24px;
    font-family: var(--fuente-titulo);
    font-style: italic;
    font-size: 22px;
    color: var(--cobre-hondo);
  }
</style>
