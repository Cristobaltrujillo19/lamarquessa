---
// Banda ancha con espacio para una foto de ambiente y una frase de marca encima.
// Para usar una foto real: poner background-image en .banda y quitar el placeholder.
import IconoVelero from './IconoVelero.astro';

interface Props {
  /** Frase encima (puede traer <br/>). */
  frase?: string;
  etiqueta?: string;
}
const { frase = 'Del amor, del mar<br />y del amor al mar.', etiqueta = 'Foto de ambiente próximamente' } = Astro.props;
---

<section class="banda">
  <IconoVelero tamano={140} class="marca-agua" />
  <p class="frase" set:html={frase}></p>
  <span class="etq">{etiqueta}</span>
</section>

<style>
  .banda {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(360px, 52vw, 560px);
    padding: clamp(40px, 8vw, 90px);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 58% 58% at 50% 26%, color-mix(in srgb, var(--aqua) 85%, transparent), transparent 70%),
      radial-gradient(ellipse 70% 60% at 82% 92%, color-mix(in srgb, var(--rosa-nacar) 50%, transparent), transparent 72%),
      linear-gradient(150deg, var(--aqua), color-mix(in srgb, var(--aqua-hondo) 55%, var(--cielo)));
  }

  .marca-agua {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    color: var(--blanco);
    opacity: 0.2;
  }

  .frase {
    position: relative;
    font-family: var(--fuente-cita);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(30px, 6vw, 58px);
    line-height: 1.1;
    color: var(--cacao);
    text-shadow: 0 2px 24px color-mix(in srgb, var(--blanco) 60%, transparent);
  }

  .etq {
    position: absolute;
    bottom: 16px;
    right: 18px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cacao) 55%, transparent);
  }
</style>
