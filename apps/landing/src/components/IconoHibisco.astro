---
// Hibisco del manual de marca (vector oficial del PDF, currentColor).
import hibisco from '../svg/hibisco.svg?raw';
interface Props { tamano?: number; class?: string; }
const { tamano = 64, class: clase } = Astro.props;
---
<span class:list={['marca-icono', clase]} style={`--t:${tamano}px`} set:html={hibisco} aria-hidden="true"></span>

<style>
  .marca-icono {
    display: inline-block;
    line-height: 0;
    color: inherit;
  }
  .marca-icono :global(svg) {
    display: block;
    width: var(--t);
    height: auto;
  }
</style>
