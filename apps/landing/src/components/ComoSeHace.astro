---
import IconoConcha from './IconoConcha.astro';
import IconoVelero from './IconoVelero.astro';
import IconoHibisco from './IconoHibisco.astro';

const pasos = [
  {
    Icono: IconoConcha,
    titulo: 'Lo diseñamos',
    texto: 'Cada bolso parte de un trazo propio, dibujado a mano e inspirado en el mar.',
  },
  {
    Icono: IconoVelero,
    titulo: 'Lo imprimimos en 3D',
    texto: 'Capa sobre capa, la impresión deja surcos como los que el mar dibuja en la arena.',
  },
  {
    Icono: IconoHibisco,
    titulo: 'Lo terminamos a mano',
    texto: 'Ensamblado y rematado a mano. Una pieza única, hecha para durar.',
  },
];
---

<section id="proceso" class="seccion proceso">
  <div class="contenedor">
    <header class="encabezado reveal">
      <p class="kicker">Capa sobre capa</p>
      <h2 class="titulo-seccion">Cada capa, una <span class="script">ola</span></h2>
    </header>

    <ol class="pasos">
      {
        pasos.map(({ Icono, titulo, texto }) => (
          <li class="paso reveal">
            <div class="icono-slot">
              <Icono tamano={76} class="icono" />
            </div>
            <h3>{titulo}</h3>
            <p>{texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proceso {
    background: var(--blanco);
  }

  .encabezado {
    text-align: center;
    margin-bottom: clamp(44px, 6vw, 70px);
  }

  .pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(32px, 5vw, 56px);
  }

  .paso {
    text-align: center;
  }

  .icono-slot {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .icono-slot :global(svg) {
    width: auto !important;
    height: 74px !important;
    max-width: 100%;
  }

  .icono {
    color: var(--cobre);
  }

  h3 {
    font-size: 28px;
    color: var(--cacao);
  }

  p {
    margin-top: 10px;
    color: var(--cacao-suave);
    max-width: 32ch;
    margin-inline: auto;
  }
</style>
