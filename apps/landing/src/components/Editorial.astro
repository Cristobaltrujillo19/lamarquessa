---
// Bloque editorial: texto + un espacio elegante reservado para una foto.
// Cuando llegue la foto real, se reemplaza el .lienzo por <img>.
import IconoConcha from './IconoConcha.astro';
import IconoVelero from './IconoVelero.astro';
import IconoHibisco from './IconoHibisco.astro';

interface Props {
  kicker?: string;
  /** Puede traer <span class="script">…</span>. */
  titulo: string;
  texto: string;
  lado?: 'izquierda' | 'derecha';
  etiqueta?: string;
  simbolo?: 'concha' | 'velero' | 'hibisco';
  cta?: { texto: string; href: string };
}

const {
  kicker,
  titulo,
  texto,
  lado = 'izquierda',
  etiqueta = 'Foto próximamente',
  simbolo = 'concha',
  cta,
} = Astro.props;

const Icono = { concha: IconoConcha, velero: IconoVelero, hibisco: IconoHibisco }[simbolo];
---

<section class:list={['seccion', 'editorial', lado]}>
  <div class="contenedor grid">
    <figure class="lienzo reveal">
      <Icono tamano={120} class="marca-agua" />
      <figcaption>{etiqueta}</figcaption>
    </figure>
    <div class="texto reveal">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 class="titulo-seccion" set:html={titulo}></h2>
      <p class="cuerpo">{texto}</p>
      {cta && <a class="boton boton-primario" href={cta.href}>{cta.texto}</a>}
    </div>
  </div>
</section>

<style>
  .editorial {
    background: var(--crema);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }

  .derecha .lienzo {
    order: 2;
  }

  .lienzo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    border-radius: var(--radio);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 38%, var(--blanco), transparent 72%),
      linear-gradient(160deg, var(--arena-clara), var(--arena));
  }

  .marca-agua {
    opacity: 0.4;
    color: var(--cobre);
  }

  figcaption {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cacao) 55%, transparent);
  }

  .cuerpo {
    margin-top: 18px;
    color: var(--cacao-suave);
    font-size: clamp(16px, 2vw, 18px);
    max-width: 46ch;
  }

  .texto .boton {
    margin-top: 28px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .derecha .lienzo {
      order: 0;
    }
    .lienzo {
      aspect-ratio: 3 / 2;
    }
  }
</style>
