---
import IconoWhatsApp from './IconoWhatsApp.astro';
import { enlaceWhatsApp, MENSAJES } from '../lib/site';
---

<a
  id="fab-whatsapp"
  href={enlaceWhatsApp(MENSAJES.general)}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
>
  <IconoWhatsApp tamano={28} />
</a>

<style>
  #fab-whatsapp {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: var(--wa-verde);
    color: #fff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  #fab-whatsapp.visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  html:not(.js) #fab-whatsapp {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #fab-whatsapp {
      transition: opacity 0.3s ease;
      transform: none;
    }
  }
</style>
