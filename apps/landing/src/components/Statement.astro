---
// Banda ancha con una frase de marca (los "statements" del manual).
interface Props {
  /** Tema de color de la banda. */
  tono?: 'cobre' | 'arena' | 'cacao';
}
const { tono = 'cobre' } = Astro.props;
---

<section class:list={['statement', tono]}>
  <p class="frase reveal"><slot /></p>
</section>

<style>
  .statement {
    text-align: center;
    padding-block: clamp(70px, 11vw, 120px);
    padding-inline: clamp(22px, 6vw, 40px);
  }

  .frase {
    font-family: var(--fuente-titulo);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(26px, 5vw, 50px);
    line-height: 1.2;
    max-width: 18ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .cobre {
    background: var(--cobre);
  }
  .cobre .frase {
    color: var(--blanco);
  }

  .arena {
    background: var(--arena);
  }
  .arena .frase {
    color: var(--cacao);
  }

  .cacao {
    background: var(--cacao);
  }
  .cacao .frase {
    color: var(--crema);
  }
</style>
