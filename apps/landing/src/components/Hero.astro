---
import LogoMarca from './LogoMarca.astro';
import { enlaceWhatsApp, MENSAJES, TAGLINE } from '../lib/site';
---

<section id="inicio" class="hero shimmer">
  <div class="hero-inner">
    <p class="kicker reveal">Bolsos impresos en 3D · Hechos en Colombia</p>

    <h1 class="logo-hero reveal">
      <LogoMarca variante="cobre" tamano={120} />
    </h1>

    <p class="tagline reveal">{TAGLINE}</p>

    <p class="bajada reveal">
      Bolsos de autor, diseñados e impresos en 3D y terminados a mano, con
      materiales colombianos. Piezas exclusivas inspiradas en el mar.
    </p>

    <div class="acciones reveal">
      <a class="boton boton-primario" href="#coleccion">Ver los bolsos</a>
      <a
        class="boton boton-fantasma"
        href={enlaceWhatsApp(MENSAJES.general)}
        target="_blank"
        rel="noopener">Escríbenos</a
      >
    </div>
  </div>
</section>

<style>
  /* Hero firma: luz nácar a todo el ancho con el wordmark de la marca encima.
     Sin foto (la fotografía va en otras secciones), sin destellos ni motivos. */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(540px, 78vh, 840px);
    display: grid;
    place-items: center;
    text-align: center;
    padding: clamp(72px, 9vh, 130px) clamp(22px, 6vw, 40px);
    background:
      radial-gradient(
        58% 48% at 50% 46%,
        color-mix(in srgb, var(--blanco) 48%, transparent),
        transparent 76%
      ),
      radial-gradient(
        80% 60% at 14% 4%,
        color-mix(in srgb, var(--rosa-nacar) 88%, transparent),
        transparent 60%
      ),
      radial-gradient(
        78% 58% at 88% 2%,
        color-mix(in srgb, var(--aqua) 92%, transparent),
        transparent 62%
      ),
      radial-gradient(
        120% 70% at 50% 122%,
        color-mix(in srgb, var(--lila-nacar) 76%, transparent),
        transparent 60%
      ),
      linear-gradient(180deg, var(--blanco), var(--espuma));
  }

  /* Patrón de veleros del manual, apenas perceptible */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/marca/patron-cobre.png');
    background-size: 340px;
    opacity: 0.04;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1000px;
  }

  .logo-hero {
    margin: 22px 0 6px;
    display: flex;
    justify-content: center;
  }

  .logo-hero :global(img) {
    /* wordmark ancho y horizontal: dimensionamos por ancho para llenar los lados */
    width: min(720px, 90%);
    height: auto !important;
  }

  .tagline {
    margin-top: 18px;
    font-family: var(--fuente-cita);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(21px, 2.6vw, 30px);
    color: color-mix(in srgb, var(--aqua-hondo) 82%, var(--cacao));
  }

  .bajada {
    max-width: 52ch;
    margin: 18px auto 0;
    color: var(--cacao-suave);
    font-size: clamp(16px, 1.5vw, 18px);
  }

  .acciones {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
</style>
