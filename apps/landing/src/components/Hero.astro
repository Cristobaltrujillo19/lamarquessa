---
import LogoMarca from './LogoMarca.astro';
import Carrusel from './Carrusel.astro';
import { enlaceWhatsApp, MENSAJES, TAGLINE } from '../lib/site';
---

<section id="inicio" class="hero">
  <div class="hero-top">
    <div class="hero-logo" data-hero-logo>
      <LogoMarca variante="cobre" tamano={88} />
    </div>
    <p class="hero-tagline">{TAGLINE}</p>
  </div>

  <Carrusel />

  <div class="hero-cta">
    <a class="boton boton-primario" href="#coleccion">Ver los bolsos</a>
    <a
      class="boton boton-fantasma"
      href={enlaceWhatsApp(MENSAJES.general)}
      target="_blank"
      rel="noopener">Escríbenos</a
    >
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(20px, 3vh, 40px);
    padding-bottom: clamp(40px, 6vh, 72px);
    background:
      radial-gradient(
        72% 42% at 50% 0%,
        color-mix(in srgb, var(--rosa-nacar) 52%, transparent),
        transparent 62%
      ),
      radial-gradient(
        62% 40% at 90% 0%,
        color-mix(in srgb, var(--aqua) 58%, transparent),
        transparent 62%
      ),
      linear-gradient(180deg, var(--blanco), var(--espuma));
  }

  .hero-top {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-inline: clamp(22px, 6vw, 40px);
    margin-bottom: clamp(20px, 3vh, 34px);
  }

  .hero-logo {
    display: flex;
    justify-content: center;
    transform-origin: center top;
    will-change: transform, opacity;
  }

  .hero-logo :global(img) {
    /* logo central del hero (se transforma en el del header al hacer scroll) */
    height: clamp(58px, 9vw, 92px) !important;
    width: auto;
    max-width: 90%;
  }

  .hero-tagline {
    font-family: var(--fuente-cita);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: color-mix(in srgb, var(--aqua-hondo) 82%, var(--cacao));
  }

  .hero-cta {
    margin-top: clamp(22px, 3vh, 34px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-inline: clamp(22px, 6vw, 40px);
  }
</style>
