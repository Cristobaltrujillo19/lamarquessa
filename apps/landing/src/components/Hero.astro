---
import LogoMarca from './LogoMarca.astro';
import IconoOlas from './IconoOlas.astro';
import { enlaceWhatsApp, MENSAJES, TAGLINE } from '../lib/site';
---

<section id="inicio" class="hero">
  <div class="contenedor centro">
    <p class="kicker reveal">Bolsos impresos en 3D · Hechos en Colombia</p>

    <h1 class="logo-hero reveal">
      <LogoMarca variante="imagotipo" tamano={270} />
    </h1>

    <p class="tagline reveal">{TAGLINE}</p>

    <p class="bajada reveal">
      Bolsos de autor, diseñados e impresos en 3D y terminados a mano, con
      materiales locales de Colombia. Piezas únicas inspiradas en el mar.
    </p>

    <div class="acciones reveal">
      <a class="boton boton-primario" href="#coleccion">Ver los bolsos</a>
      <a
        class="boton boton-fantasma"
        href={enlaceWhatsApp(MENSAJES.general)}
        target="_blank"
        rel="noopener">Escríbenos</a
      >
    </div>
  </div>

  <a href="#beneficios" class="bajar" aria-label="Bajar">
    <IconoOlas class="olas-bajar" />
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 0%,
        color-mix(in srgb, var(--cielo) 40%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 90% 60% at 50% 115%,
        color-mix(in srgb, var(--arena) 55%, transparent),
        transparent 70%
      ),
      var(--crema);
  }

  .centro {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 860px;
    padding-block: clamp(56px, 11vw, 110px) clamp(80px, 14vw, 150px);
  }

  .logo-hero {
    margin: 26px 0 4px;
    display: flex;
    justify-content: center;
  }

  .logo-hero :global(img) {
    height: clamp(150px, 30vw, 270px);
  }

  .tagline {
    margin-top: 20px;
    font-family: var(--fuente-titulo);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 3vw, 28px);
    color: var(--cobre-hondo);
  }

  .bajada {
    max-width: 50ch;
    margin: 18px auto 0;
    color: var(--cacao-suave);
    font-size: clamp(16px, 2vw, 18px);
  }

  .acciones {
    margin-top: 38px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .bajar {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    width: 70px;
    color: color-mix(in srgb, var(--cacao) 40%, transparent);
  }

  .olas-bajar {
    width: 70px;
    height: 12px;
  }
</style>
