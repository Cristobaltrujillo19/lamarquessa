---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Beneficios from '../components/Beneficios.astro';
import Coleccion from '../components/Coleccion.astro';
import ComoSeHace from '../components/ComoSeHace.astro';
import BandaFoto from '../components/BandaFoto.astro';
import ListaEspera from '../components/ListaEspera.astro';
import Footer from '../components/Footer.astro';
import FabWhatsApp from '../components/FabWhatsApp.astro';
---

<Base
  titulo="La Marquessa — Bolsos impresos en 3D, hechos en Colombia"
  descripcion="Bolsos de autor diseñados e impresos en 3D y terminados a mano, con materiales colombianos. Piezas exclusivas inspiradas en el mar."
>
  <Header />
  <main>
    <Hero />
    <Coleccion />
    <Beneficios />
    <ComoSeHace />
    <BandaFoto />
    <ListaEspera />
  </main>
  <Footer />
  <FabWhatsApp />
</Base>
